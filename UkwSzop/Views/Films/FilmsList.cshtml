@model IEnumerable<UkwSzop.Models.Film>

@{
    ViewData["Title"] = "Filmy z kategorii";
}

<table class="table">
    <thead>
        <tr>
            <th>Tytuł filmu</th>
            <th>Reżyser</th>
            <th>Data dodania</th>
            <th>Cena</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var film in Model)
        {
            <tr>
                <td>@film.Title</td>
                <td>@film.Director</td>
                <td>@film.DateAdded.ToString("dd.MM.yyyy")</td>
                <td>@film.Price zł</td>
            </tr>
        }
    </tbody>
</table>
